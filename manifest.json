{
  "manifest_version": 3,
  "name": "Pump Lens \u2014 Keyword Highlighter",
  "version": "1.0.0",
  "description": "Highlight pump.fun with positive and negative matching rules, plus a ChatGPT keyword workflow.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Pump Lens",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_page": "index.html",
  "content_scripts": [
    {
      "matches": [
        "https://pump.fun/*",
        "https://*.pump.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "highlights.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
